# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Veil
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production: 32+ random characters. Used for admin sessions,
# signed job tokens and the daily-rotating IP hash. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVER_SECRET=

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# devnet | testnet | mainnet-beta. The server refuses an RPC whose genesis hash
# doesn't match this network.
SOLANA_NETWORK=devnet
# Server-side RPC (may contain a provider API key; never sent to browsers).
SOLANA_RPC_URL=
# Optional public RPC for browsers. If empty, browsers use the allow-listed
# /api/solana/rpc proxy (which forwards to SOLANA_RPC_URL).
NEXT_PUBLIC_SOLANA_RPC_URL=
# Optional: enables WalletConnect-compatible Solana wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ---------------------------------------------------------------------------
# Project token (pump.fun). Leave PROJECT_TOKEN_MINT empty until launch.
# ---------------------------------------------------------------------------
PROJECT_TOKEN_MINT=
PROJECT_TOKEN_SYMBOL=VEIL
PROJECT_TOKEN_NAME=Veil
PROJECT_TOKEN_DECIMALS=6
# Optional override; defaults to https://pump.fun/coin/<mint>
PUMP_URL=

# ---------------------------------------------------------------------------
# Payments & credits
# ---------------------------------------------------------------------------
# Wallet that receives SOL / USDC / token payments. Payments are disabled until set.
TREASURY_WALLET=
# Defaults to Circle's USDC mint for the selected network.
USDC_MINT=
# Extra credits when paying with the project token (1000 = +10%).
TOKEN_CREDIT_BONUS_BPS=1000
# Plan price discount when paying with the project token (1000 = 10%).
TOKEN_PLAN_DISCOUNT_BPS=1000
# Burning the project token for credits/plans costs this much less than USDC (2000 = 20%).
TOKEN_BURN_DISCOUNT_BPS=2000
CREDITS_PER_USD=100
CREDIT_PACKAGES_USD=10,25,50,100
# Markup over provider list price when metering usage (2000 = +20%).
PRICE_MARKUP_BPS=2000
FREE_DAILY_MESSAGES=20
PLAN_PRO_USD=12
PLAN_PRO_CREDITS=1500
PLAN_MAX_USD=60
PLAN_MAX_CREDITS=8500
PLAN_DURATION_DAYS=30
# "finalized" (default on mainnet) or "confirmed" (default elsewhere).
PAYMENT_COMMITMENT=
PAYMENT_INTENT_TTL_SECONDS=180
# Holders of at least this many tokens can verify for boosted free limits (0 = off).
TOKEN_GATE_HOLDER_MIN=0

# ---------------------------------------------------------------------------
# AI providers — server-only. A model is offered only if its provider key is set.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace (the API asks for an anthropic-workspace-id header).
ANTHROPIC_WORKSPACE_ID=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
REPLICATE_API_TOKEN=
# Any OpenAI-compatible endpoint (vLLM, Ollama, LM Studio, a gateway, …)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
# JSON array adding/overriding chat models, e.g.
# [{"id":"llama-local","label":"Llama (local)","family":"Llama","provider":"custom","upstream":"llama3.1","tools":true,"free":true,"tier":"fast","priceIn":0,"priceOut":0}]
CUSTOM_MODELS=
# Comma-separated model ids to hide.
DISABLED_MODELS=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required in production. In development an embedded PGlite database is used
# when this is empty (stored in .data/pglite or PGLITE_DIR).
DATABASE_URL=
PGLITE_DIR=

# Optional: Upstash Redis for rate limits shared across instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Admin (token launch, treasury buyback/burn)
# ---------------------------------------------------------------------------
# Comma-separated wallet public keys allowed to sign in to /admin.
ADMIN_WALLETS=
# Mainnet token creation stays disabled unless this is exactly "true".
ALLOW_MAINNET_TOKEN_CREATION=false
# "planned" until buyback/burn are genuinely operating; shown on the landing page.
TOKEN_BUYBACK_STATUS=planned
# Share of net revenue proposed for buybacks (2000 = 20%). Proposals still need review.
BUYBACK_ALLOCATION_BPS=2000
# Optional: lets the admin launch page upload image + metadata to IPFS.
PINATA_JWT=
